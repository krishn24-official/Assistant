# Fill in whichever free-tier keys you actually have - all are optional,
# the app skips any provider without a key.

GROQ_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
YOUTUBE_API_KEY=

# Order to try providers in, comma separated. First success wins.
LLM_PROVIDER_ORDER=groq,mistral,anthropic

GROQ_MODEL=llama-3.3-70b-versatile
MISTRAL_MODEL=mistral-large-latest
ANTHROPIC_MODEL=claude-sonnet-4-6

DB_PATH=assistant_memory.db
HOST=0.0.0.0
PORT=8008
